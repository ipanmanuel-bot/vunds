# Neon Postgres (pooled connection string from the Neon console)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js (deferred until the real sign-in phase)
AUTH_SECRET=                        # generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth — used by Gmail import (Phase 7). Create credentials at
# https://console.cloud.google.com → APIs & Services → Credentials.
# Required scope: https://www.googleapis.com/auth/gmail.readonly
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# AES-256-GCM key for encrypting OAuth tokens at rest (64 hex chars = 32 bytes).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
